# 应用配置
APP_NAME=User Service
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=True

# 服务配置
HOST=0.0.0.0
PORT=8000

# 数据库配置 (SQLite)
DATABASE_URL=sqlite+aiosqlite:///./data/user_service.db
DATABASE_ECHO=False

# JWT 配置（RS256 非对称加密）
# 私钥仅保留在签发服务，公钥可分发到其他服务用于校验
# 值既可以是 PEM 文件路径，也可以是 PEM 字符串
JWT_PRIVATE_KEY=keys/jwt_private.pem
JWT_PUBLIC_KEY=keys/jwt_public.pem
ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# 密码加密
PASSWORD_BCRYPT_ROUNDS=12

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/user_service.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# CORS 配置
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# 日志操作类型
LOG_OPERATIONS=["user_create","user_update","user_delete","user_login","user_logout","password_change","user_status_change","role_change"]
